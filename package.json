{
  "name": "canvas2d-webgl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Canvas 2D compatibility contracts for a WebGL 1 renderer",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.json",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "pnpm run test:unit",
    "test:unit": "node scripts/unit.mjs",
    "test:browser": "node scripts/testing.mjs browser",
    "test:report": "node scripts/testing.mjs report",
    "test:acceptance": "node scripts/testing.mjs acceptance",
    "test:matrix": "node scripts/acceptance-matrix.mjs",
    "test:review-index": "node scripts/acceptance-review.mjs",
    "pretest:review-index": "pnpm run build",
    "pretest:matrix": "pnpm run build",
    "verify": "pnpm run check && pnpm run format:check && pnpm run test:unit",
    "pretest:unit": "pnpm run build",
    "pretest:browser": "pnpm run build",
    "pretest:report": "pnpm run build",
    "pretest:acceptance": "pnpm run build",
    "test:smoke": "node scripts/harness-smoke.mjs",
    "pretest:smoke": "pnpm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.6.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "typescript": "7.0.2"
  }
}
