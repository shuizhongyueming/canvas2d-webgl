{
  "name": "canvas2d-webgl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Canvas 2D compatibility contracts for a WebGL 1 renderer",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.json",
    "test": "npm run test:unit",
    "test:unit": "node scripts/unit.mjs",
    "test:browser": "node scripts/testing.mjs browser",
    "test:report": "node scripts/testing.mjs report",
    "test:acceptance": "node scripts/testing.mjs acceptance",
    "verify": "npm run check && npm run test:unit",
    "pretest:unit": "npm run build",
    "pretest:browser": "npm run build",
    "pretest:report": "npm run build",
    "pretest:acceptance": "npm run build",
    "test:smoke": "node scripts/harness-smoke.mjs",
    "pretest:smoke": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "typescript": "7.0.2"
  }
}
